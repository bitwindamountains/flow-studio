{
  "name": "flow-mcp",
  "version": "0.1.0",
  "description": "Local MCP server that drives Google Flow in a dedicated Chrome profile",
  "main": "index.js",
  "scripts": {
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "test:terminal": "npm run build && node scripts/test-terminal-ui.mjs",
    "test:accounts": "npm run build && node scripts/test-account-identity.mjs",
    "test:workflow": "npm run build && node scripts/test-workflow-ui.mjs",
    "build": "tsc",
    "start": "node dist/index.js",
    "login": "node dist/login.js",
    "studio": "node dist/studio.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bin": {
    "flow-mcp": "dist/index.js"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "playwright-core": "^1.63.0",
    "ws": "^8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
